# ==============================================================================
# Placement Prep Tracker - Environment Configuration Template
# ==============================================================================
# Developers cloning this repository must create their own Firebase project
# at https://console.firebase.google.com/ and configure Authentication & Firestore.
#
# Copy this file to '.env' and fill in your Firebase Web App configuration values:
#   cp .env.example .env
# ==============================================================================

# Required: Firebase Web Client Credentials
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"

# Firestore Database ID:
# Defaults to "(default)" unless you provisioned a named Firestore database.
VITE_FIREBASE_DATABASE_ID="(default)"

# Optional: Host URL and Application Keys
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""
